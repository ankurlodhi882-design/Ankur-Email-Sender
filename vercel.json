{
  "version": 2,

  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],

  "routes": [
    {
      "src": "/static/(.*)",
      "headers": {
        "cache-control": "public, max-age=86400"
      },
      "continue": true
    },

    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ]
}
